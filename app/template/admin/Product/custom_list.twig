{% extends '@admin/default_frame.twig' %}

{% set menus = ['product', 'custom_product_list'] %}

{% block title %}{{ 'admin.product.custom_product_list'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.product.product_management'|trans }}{% endblock %}

{% form_theme searchForm '@admin/Form/bootstrap_4_layout.html.twig' %}

{% block stylesheet %}
    <style>
        .custom-product-thumb {
            width: 52px;
            height: 52px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #dee2e6;
            background-color: #f8f9fa;
        }
        .custom-stat-card {
            border-radius: 8px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .custom-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.08)!important;
        }
        .badge-category {
            font-size: 0.75rem;
            font-weight: 500;
            background-color: #e9ecef;
            color: #495057;
            margin-right: 4px;
            margin-bottom: 2px;
            display: inline-block;
            padding: 2px 6px;
            border-radius: 4px;
        }
    </style>
{% endblock %}

{% block javascript %}
    <script>
        $(function() {
            // Reset Search Form
            $('#btn_clear_search').on('click', function(e) {
                e.preventDefault();
                location.href = "{{ url('admin_product_custom_list') }}";
            });
        });
    </script>
{% endblock %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">

                <!-- Header Action & Title Bar -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="mb-1 fw-bold text-dark">
                            <i class="fa fa-cubes text-primary me-2"></i>{{ 'admin.product.custom_product_list'|trans }}
                        </h4>
                        <p class="text-muted small mb-0">{{ 'admin.product.custom_product_list_description'|trans }}</p>
                    </div>
                    <div>
                        <a href="{{ url('admin_product_product_new') }}" class="btn btn-ec-conversion shadow-sm">
                            <i class="fa fa-plus me-1"></i> {{ 'admin.product.product_registration'|trans }}
                        </a>
                    </div>
                </div>

                <!-- Summary Statistics Cards -->
                <div class="row g-3 mb-4">
                    <!-- Total Products Card -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card custom-stat-card border-0 border-start border-4 border-primary shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="text-muted text-uppercase mb-1 small fw-bold">{{ 'admin.product.stat_total_products'|trans }}</h6>
                                        <h3 class="fw-bold mb-0 text-dark">{{ stats.total_products|number_format }}</h3>
                                    </div>
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fa fa-cubes fa-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Published Products Card -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card custom-stat-card border-0 border-start border-4 border-success shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="text-muted text-uppercase mb-1 small fw-bold">{{ 'admin.product.stat_public_products'|trans }}</h6>
                                        <h3 class="fw-bold mb-0 text-success">{{ stats.public_products|number_format }}</h3>
                                    </div>
                                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fa fa-check-circle fa-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden Products Card -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card custom-stat-card border-0 border-start border-4 border-secondary shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="text-muted text-uppercase mb-1 small fw-bold">{{ 'admin.product.stat_hidden_products'|trans }}</h6>
                                        <h3 class="fw-bold mb-0 text-secondary">{{ stats.hidden_products|number_format }}</h3>
                                    </div>
                                    <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fa fa-eye-slash fa-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total Categories Card -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card custom-stat-card border-0 border-start border-4 border-info shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="text-muted text-uppercase mb-1 small fw-bold">{{ 'admin.product.stat_total_categories'|trans }}</h6>
                                        <h3 class="fw-bold mb-0 text-info">{{ stats.total_categories|number_format }}</h3>
                                    </div>
                                    <div class="bg-info bg-opacity-10 text-info rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fa fa-folder-open fa-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Search Filter Form Card -->
                <div class="card rounded border-0 shadow-sm mb-4">
                    <div class="card-header bg-light py-3 border-0">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="fa fa-search me-2 text-primary"></i>{{ 'admin.common.search__filter'|trans }}
                        </h6>
                    </div>
                    <div class="card-body">
                        <form name="admin_search_custom_product" method="get" action="{{ url('admin_product_custom_list') }}">
                            <div class="row g-3">
                                <!-- Keyword (ID, Name, Code) -->
                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-bold small text-muted">{{ 'admin.product.multi_search_label'|trans }}</label>
                                    {{ form_widget(searchForm.id, {'attr': {'class': 'form-control', 'placeholder': 'ID, Product Name, Code'}}) }}
                                </div>

                                <!-- Category -->
                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-bold small text-muted">{{ 'admin.product.category'|trans }}</label>
                                    {{ form_widget(searchForm.category_id, {'attr': {'class': 'form-select form-control'}}) }}
                                </div>

                                <!-- Create Date Range -->
                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-bold small text-muted">{{ 'admin.common.create_date'|trans }}</label>
                                    <div class="input-group">
                                        {{ form_widget(searchForm.create_date_start, {'attr': {'class': 'form-control', 'type': 'date'}}) }}
                                        <span class="input-group-text bg-light">~</span>
                                        {{ form_widget(searchForm.create_date_end, {'attr': {'class': 'form-control', 'type': 'date'}}) }}
                                    </div>
                                </div>

                                <!-- Display Status -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold small text-muted d-block">{{ 'admin.product.display_status'|trans }}</label>
                                    <div class="d-flex flex-wrap gap-3">
                                        {{ form_widget(searchForm.status) }}
                                    </div>
                                </div>

                                <!-- Stock Status -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold small text-muted d-block">{{ 'admin.product.stock'|trans }}</label>
                                    <div class="d-flex flex-wrap gap-3">
                                        {{ form_widget(searchForm.stock) }}
                                    </div>
                                </div>
                            </div>

                            <hr class="my-3 text-muted opacity-25">

                            <!-- Action Buttons -->
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" id="btn_clear_search" class="btn btn-ec-sub px-3">
                                    <i class="fa fa-refresh me-1"></i> {{ 'admin.common.reset'|trans }}
                                </button>
                                <button type="submit" class="btn btn-ec-conversion px-4">
                                    <i class="fa fa-search me-1"></i> {{ 'admin.common.search'|trans }}
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Products Table Card -->
                <div class="card rounded border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">
                                <i class="fa fa-list me-2 text-primary"></i>{{ 'admin.product.custom_product_list'|trans }}
                            </h6>
                        </div>
                        <div>
                            {% if pagination and pagination.totalItemCount > 0 %}
                                <span class="badge bg-primary px-3 py-2 fs-7">
                                    {{ 'admin.common.count'|trans({'%count%': pagination.totalItemCount|number_format}) }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="card-body p-0">
                        {% if pagination and pagination.totalItemCount > 0 %}
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                    <tr>
                                        <th class="ps-3 py-3" style="width: 70px;">ID</th>
                                        <th class="py-3" style="width: 70px;">Image</th>
                                        <th class="py-3" style="min-width: 200px;">Product Details</th>
                                        <th class="py-3" style="min-width: 150px;">Category</th>
                                        <th class="py-3 text-end" style="width: 130px;">Price</th>
                                        <th class="py-3 text-center" style="width: 100px;">Stock</th>
                                        <th class="py-3 text-center" style="width: 110px;">Status</th>
                                        <th class="py-3" style="width: 150px;">Created Date</th>
                                        <th class="pe-3 py-3 text-end" style="width: 120px;">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for Product in pagination %}
                                        <tr>
                                            <!-- Product ID -->
                                            <td class="ps-3 fw-bold text-muted">{{ Product.id }}</td>

                                            <!-- Thumbnail Image -->
                                            <td>
                                                <a href="{{ url('admin_product_product_edit', { id: Product.id }) }}">
                                                    {% if Product.ProductImage is not empty and Product.ProductImage.0.fileName %}
                                                        <img src="{{ asset(Product.ProductImage.0.fileName, 'save_image') }}"
                                                             alt="{{ Product.name }}"
                                                             class="custom-product-thumb">
                                                    {% else %}
                                                        <div class="custom-product-thumb d-flex align-items-center justify-content-center text-muted">
                                                            <i class="fa fa-image fa-lg"></i>
                                                        </div>
                                                    {% endif %}
                                                </a>
                                            </td>

                                            <!-- Product Name & Code -->
                                            <td>
                                                <div class="fw-bold">
                                                    <a href="{{ url('admin_product_product_edit', { id: Product.id }) }}" class="text-dark text-decoration-none hover-primary">
                                                        {{ Product.name }}
                                                    </a>
                                                </div>
                                                {% if Product.code_min %}
                                                    <div class="mt-1">
                                                        <span class="badge bg-light text-dark border font-monospace">
                                                            {{ Product.code_min }}{% if Product.code_min != Product.code_max %} ~ {{ Product.code_max }}{% endif %}
                                                        </span>
                                                    </div>
                                                {% endif %}
                                            </td>

                                            <!-- Categories -->
                                            <td>
                                                {% if Product.ProductCategories is not empty %}
                                                    <div class="d-flex flex-wrap">
                                                        {% for ProductCategory in Product.ProductCategories %}
                                                            <span class="badge-category">
                                                                {{ ProductCategory.Category.name }}
                                                            </span>
                                                        {% endfor %}
                                                    </div>
                                                {% else %}
                                                    <span class="text-muted small">-</span>
                                                {% endif %}
                                            </td>

                                            <!-- Price -->
                                            <td class="text-end fw-bold text-dark text-nowrap">
                                                {% if Product.hasProductClass %}
                                                    {% if Product.getPrice02Min == Product.getPrice02Max %}
                                                        {{ Product.getPrice02IncTaxMin|price }}
                                                    {% else %}
                                                        {{ Product.getPrice02IncTaxMin|price }} <span class="text-muted fw-normal">～</span> {{ Product.getPrice02IncTaxMax|price }}
                                                    {% endif %}
                                                {% else %}
                                                    {{ Product.getPrice02IncTaxMin|price }}
                                                {% endif %}
                                            </td>

                                            <!-- Stock -->
                                            <td class="text-center">
                                                {% if Product.hasProductClass %}
                                                    <a href="{{ url('admin_product_product_class', { id: Product.id, return_product_list: true }) }}" class="badge bg-light text-primary border text-decoration-none">
                                                        {{ 'admin.product.class__short'|trans }}
                                                    </a>
                                                {% elseif Product.stockUnlimitedMin %}
                                                    <span class="badge bg-info bg-opacity-10 text-info">
                                                        {{ 'admin.product.stock_unlimited__short'|trans }}
                                                    </span>
                                                {% else %}
                                                    <span class="badge {% if Product.stockMin > 0 %}bg-success bg-opacity-10 text-success{% else %}bg-danger bg-opacity-10 text-danger{% endif %}">
                                                        {{ Product.stockMin|number_format }}
                                                    </span>
                                                {% endif %}
                                            </td>

                                            <!-- Status -->
                                            <td class="text-center">
                                                {% if Product.Status.id == constant('Eccube\\Entity\\Master\\ProductStatus::DISPLAY_SHOW') %}
                                                    <span class="badge bg-success">{{ Product.Status.name }}</span>
                                                {% elseif Product.Status.id == constant('Eccube\\Entity\\Master\\ProductStatus::DISPLAY_HIDE') %}
                                                    <span class="badge bg-secondary">{{ Product.Status.name }}</span>
                                                {% else %}
                                                    <span class="badge bg-danger">{{ Product.Status.name }}</span>
                                                {% endif %}
                                            </td>

                                            <!-- Created Date -->
                                            <td class="text-muted small">
                                                <div><i class="fa fa-calendar-o me-1"></i>{{ Product.create_date|date('Y/m/d') }}</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">{{ Product.create_date|date('H:i') }}</div>
                                            </td>

                                            <!-- Actions -->
                                            <td class="pe-3 text-end">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <!-- View Front Detail -->
                                                    <a href="{{ url('product_detail', { id: Product.id }) }}"
                                                       target="_blank"
                                                       class="btn btn-outline-secondary"
                                                       data-bs-toggle="tooltip"
                                                       title="{{ 'admin.common.display'|trans }}">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                    <!-- Edit in Admin -->
                                                    <a href="{{ url('admin_product_product_edit', { id: Product.id }) }}"
                                                       class="btn btn-outline-primary"
                                                       data-bs-toggle="tooltip"
                                                       title="{{ 'admin.common.edit'|trans }}">
                                                        <i class="fa fa-pencil"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <!-- Empty State -->
                            <div class="text-center py-5">
                                <i class="fa fa-cubes fa-3x text-muted mb-3 d-block"></i>
                                <h5 class="text-muted fw-bold">{{ 'admin.common.search_no_result'|trans }}</h5>
                                <p class="text-muted small mb-0">{{ 'admin.product.no_products_message'|trans }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Pagination Footer -->
                {% if pagination and pagination.totalItemCount > 0 %}
                    <div class="row justify-content-md-center mb-4">
                        {% include "@admin/pager.twig" with {'pages': pagination.paginationData, 'routes': 'admin_product_custom_list_page'} %}
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}
